{
    // Utiliser Pylance comme serveur de langage
    "python.languageServer": "Pylance",

    // Désactiver le type checking de Pylance
    "python.analysis.typeCheckingMode": "off",

    // Activer les fonctionnalités de code lens pour Pylance
    "editor.codeLens": true,

    // Utiliser uniquement les diagnostics de BasedPyright
    "basedpyright.disableLanguageServices": true,
    "basedpyright.analysis.diagnosticMode": "workspace",

    // Configurer les tests unitaires avec pytest
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true
}
